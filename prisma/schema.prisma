model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  category      String   // "stands" | "comercial"
  subCategory   String?  // ex: "Feiras e Congressos", "Cenografia", "Lojas e Showrooms"
  description   String   // Texto detalhado sobre o projeto
  coverImage    String   // Imagem principal de destaque
  galleryImages String   // JSON array com URLs das fotos da galeria
  client        String?  // Nome do cliente / marca
  location      String?  // Ex: "São Paulo / SP", "Pavilhão Anhembi"
  year          String?  // Ex: "2024"
  area          String?  // Ex: "350 m²"
  isPublished   Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
