  DATABASE_URL="postgres://244ea0276786f2b9b97fe03417f9fbf455da13b393cca4bcfcd09eca68fc9c2a:sk_SJpS_FMefAEjCidqT3soJ@db.prisma.io:5432/postgres?sslmode=require"
  POSTGRES_URL="postgres://244ea0276786f2b9b97fe03417f9fbf455da13b393cca4bcfcd09eca68fc9c2a:sk_SJpS_FMefAEjCidqT3soJ@db.prisma.io:5432/postgres?sslmode=require"
